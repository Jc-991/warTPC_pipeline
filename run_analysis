#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd)
# Load the cluster modules from the bundled setup script (works from any cwd).
source "$SCRIPT_DIR/blackbox/setup_blackbox.sh"

SETUP_FILE="${BLACKBOX_SETUP:-$HOME/warTPC/Blackbox/setup_blackbox.sh}"
if [[ -f "$SETUP_FILE" ]]; then
  source "$SETUP_FILE"
fi
exec python3 "$SCRIPT_DIR/pipeline/pipeline.py" "$@"
